{
  "name": "scroll-pagination-react",
  "version": "1.2.1",
  "description": "A lightweight React hook for infinite scroll pagination using IntersectionObserver.",
  "author": "Ankit Pativala",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "infinite-scroll",
    "scroll",
    "pagination",
    "intersectionobserver",
    "lazy-loading",
    "typescript",
    "vite",
    "nextjs",
    "ankit",
    "ankit-pativala"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitpativala1405/scroll-pagination-react.git"
  },
  "bugs": {
    "url": "https://github.com/ankitpativala1405/scroll-pagination-react/issues"
  },
  "homepage": "https://github.com/ankitpativala1405/scroll-pagination-react#readme",
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.10",
    "jsdom": "^30.0.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
